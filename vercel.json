{
  "cleanUrls": true,
  "functions": { "api/ai.js": { "maxDuration": 30 } },
  "redirects": [
    { "source": "/lib/:path*", "destination": "/", "permanent": false },
    { "source": "/dev-server.js", "destination": "/", "permanent": false }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }, { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }]
}
